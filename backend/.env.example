# Copiez ce fichier en `.env` (jamais commité) et remplissez les valeurs.

# Supabase > Project Settings > Database > Connection string > « Session pooler » (ou Direct).
# Remplacez [YOUR-PASSWORD]. Le port 5432 (session) est requis pour les transactions.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Secret de signature des jetons (32 caractères minimum). Générer :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Clé AES-256 (64 caractères hexadécimaux) pour chiffrer les signatures de visage. Générer :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ Perdre cette clé rend les visages enregistrés illisibles : la sauvegarder séparément.
FACE_KEY=

# Distance maximale pour accepter « c'est la même personne » (plus petit = plus strict).
# Mesuré ici : même photo = 0 ; personnes différentes = 0,64 à 0,77. Une même personne sur deux photos
# différentes donne en général moins de 0,5 : À VÉRIFIER sur le terrain avec vos ouvriers et ajuster.
FACE_THRESHOLD=0.5

PORT=3000
JWT_TTL=12h

# Origines autorisées (CORS), séparées par des virgules : l'adresse où est hébergée la version WEB
# de l'application. L'application Android native n'est pas concernée par CORS.
CORS_ORIGINS=https://votre-site-web.exemple

# Mettre `false` uniquement pour un PostgreSQL local sans TLS.
DB_SSL=true
NODE_ENV=development
